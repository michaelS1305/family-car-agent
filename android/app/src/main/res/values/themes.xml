<resources>
    <!-- Platform splash only; retain the existing Activity theme and Android dismissal. -->
    <style name="Theme.Fca.Entry" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/fca_launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/fca_launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/fca_splash_icon</item>
        <item name="android:windowSplashScreenBehavior">icon_preferred</item>
    </style>
    <style name="Theme.Fca.Companion.Light" parent="android:style/Theme.Material.Light.NoActionBar" />
    <style name="Theme.Fca.Companion.Dark" parent="android:style/Theme.Material.NoActionBar" />
</resources>
