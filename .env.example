DATABASE_URL=postgresql://user:password@host:5432/database
SUPABASE_URL=https://your-project-ref.supabase.co
GOOGLE_MAPS_API_KEY=your_server_side_google_maps_api_key
GEMINI_API_KEY=your_gemini_api_key

# Web Push is disabled unless explicitly enabled. Never expose the private key.
WEB_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=your_public_vapid_key
VAPID_PRIVATE_KEY=your_private_vapid_key
VAPID_SUBJECT=mailto:your-operational-contact@example.com

# Local development only. Production should keep this false and use migrations.
RUN_DB_INIT=true

# Exact browser origins, separated by commas. Wildcards are not allowed.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
